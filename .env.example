# Copy to .env on the server (cp .env.example .env) and fill in real values.
# Never commit .env. DATABASE_URL and the Celery/Redis URLs are built in docker-compose.yml.

# Django
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=20.244.5.15,localhost
CSRF_TRUSTED_ORIGINS=http://20.244.5.15
CORS_ALLOWED_ORIGINS=http://20.244.5.15
FRONTEND_URL=http://20.244.5.15
# Plain HTTP for now. Set both to True once the domain and HTTPS are live.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# PostgreSQL (container). Use letters and digits only in the password.
POSTGRES_DB=techserv_db
POSTGRES_USER=techserv
POSTGRES_PASSWORD=replace-with-a-random-password

# Email (Gmail SMTP with an App Password). Leave EMAIL_HOST empty to log emails instead of sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=replace-with-16-char-app-password
DEFAULT_FROM_EMAIL=TechServ Hub <your-account@gmail.com>

# Azure Blob for uploaded files. Leave AZURE_CONTAINER empty to keep files on the media volume.
# Use a separate private container per environment: media-prod here, media-dev on a laptop.
# Give either the account name + key, or the full connection string (not both needed).
AZURE_CONTAINER=
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# How long file links stay valid, in seconds.
AZURE_URL_EXPIRATION_SECS=3600
